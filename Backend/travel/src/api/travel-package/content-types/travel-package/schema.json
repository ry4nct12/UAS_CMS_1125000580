{
  "kind": "collectionType",
  "collectionName": "travel_packages",
  "info": {
    "singularName": "travel-package",
    "pluralName": "travel-packages",
    "displayName": "TRAVEL PACKAGE"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "price": {
      "type": "decimal"
    },
    "duration": {
      "type": "string"
    },
    "facilities": {
      "type": "text"
    },
    "destination": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::destinasi.destinasi",
      "inversedBy": "travel_package"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "bookings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::booking.booking",
      "mappedBy": "travel_package"
    }
  }
}
